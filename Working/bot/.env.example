# Harmonic Heartbeats WhatsApp bot — environment template.
# Copy to your host's secret manager. NEVER commit real values to git.

# --- Meta WhatsApp Cloud API credentials (from developers.facebook.com) ---
# Temporary token works for testing; generate a permanent System User token for production.
WHATSAPP_TOKEN=your_access_token_here
# The "Phone number ID" shown on the WhatsApp > API Setup page (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# Any random string you invent; you paste the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=make_up_a_random_string
# Your Meta App Secret; enables webhook signature verification (recommended).
WHATSAPP_APP_SECRET=your_app_secret_here

# --- Access control (recommended for a personal bot) ---
# Comma-separated recipient numbers in E.164 without the leading + (e.g. 15551234567).
# Leave empty to allow anyone who messages the bot.
ALLOWED_RECIPIENTS=

# --- Optional ---
# WHATSAPP_GRAPH_VERSION=v21.0
# PORT=3000
